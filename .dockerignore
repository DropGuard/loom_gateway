# Build artifacts. Note: no "!target/quarkus-app/" un-exclude here — the
# multi-stage Dockerfile copies the quarkus-app from the builder stage
# (COPY --from=builder), so any local target/ contents would only bloat the
# build context with stale artifacts AND break layer caching.
target/

# Maven cache
.m2/

# IDE
.idea/
.vscode/
*.iml

# Git
.git/
.gitignore
.gitmodules

# Documentation
*.md

# Config examples
config/

# CI
.github/
